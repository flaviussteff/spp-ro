*.py[cod]
*$py.class
.pytest_cache/
.venv/
env/
venv/
ENV/
build/
dist/
*.egg-info/

# IDE & OS Metadata
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.log

# Scratch / Temp Dumps
clipboard_dump.txt
scratch/
.env
*.env*

