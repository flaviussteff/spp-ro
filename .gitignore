# ==============================================================================
# SPP-Ro Git Ignore Configuration
# ==============================================================================

# Big Data Directories (Multi-GB Corpus & Shards)
data/
*.parquet
*.jsonl
data/raw/
data/clean/
data/sidecar/
*.gz
sample_for_tokenizer.txt

# Heavy Trained Model Checkpoints & Weights
models/
*.pt
*.pth
*.bin
*.safetensors
checkpoint-*/

# Python Bytecode & Environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
env/
venv/
ENV/
build/
dist/
*.egg-info/

# IDE & OS Metadata
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.log

# Scratch / Temp Dumps
clipboard_dump.txt
scratch/
.env
*.env*

# archive/: only the small v1 scripts, evals and launchers stay tracked; big or secret parts are ignored
archive/raw_corpus/
archive/v1/models/
archive/v1/data/
archive/v1/logs/
archive/v2/
archive/v3_build/
archive/env_backups/

# Keep the explanatory READMEs inside the (otherwise ignored) data/ and models/ folders
!data/
data/*
!data/README.md
!models/
models/*
!models/README.md

# Word/Excel lock files
~$*
